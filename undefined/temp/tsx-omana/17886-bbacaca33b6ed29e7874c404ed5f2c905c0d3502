{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{merchantDisplayName}from\"@naka/engine\";import{env}from\"../config/env.js\";import{BASE_CSS,nav}from\"./ui.js\";function registerLandingRoutes(app,db){app.get(\"/\",async(_req,reply)=>{const merchants=db.prepare(\"SELECT COUNT(*) AS n FROM merchants\").get().n;const paid=db.prepare(\"SELECT COUNT(*) AS n FROM checkouts WHERE status = 'completed'\").get().n;const ledger=db.prepare(\"SELECT COUNT(*) AS n FROM ledger\").get().n;return reply.type(\"text/html\").send(landingPage({merchants,paid,ledger,mode:env.mode,defaultShop:merchantDisplayName(db,env.merchantId)}))})}__name(registerLandingRoutes,\"registerLandingRoutes\");function landingPage(s){const base=env.baseUrl.replace(/\\/$/,\"\");const tools=[[\"search_catalog\",\"find products by text, category or budget\"],[\"get_product\",\"every variant with price and stock\"],[\"create_checkout\",\"propose a cart \\u2014 priced and policy-checked by the merchant, stock reserved\"],[\"update_checkout\",\"change the cart; the same checks run again\"],[\"suggest_addons\",\"at most a few add-ons, already within the merchant's rules\"],[\"complete_checkout\",\"get the pay link for the human to confirm\"],[\"get_checkout\",\"status, including payment\"],[\"cancel_checkout\",\"release an unpaid cart\"]];return`<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Naka</title>\n<style>${BASE_CSS}\nbody{margin:0;font-family:system-ui,sans-serif;color:var(--ink);background:var(--bg)}\n.wrap{max-width:1040px;margin:0 auto;padding:0 20px}\n.hero{padding:56px 0 32px}.hero h1{font-size:2.3em;line-height:1.15;margin:0 0 12px;letter-spacing:-.02em}.hero p{font-size:1.15em;color:var(--muted);max-width:640px;margin:0 0 22px}\n.btn{display:inline-block;padding:12px 18px;border-radius:8px;text-decoration:none;font-weight:600;margin:0 10px 10px 0}.btn.primary{background:var(--accent);color:#fff}.btn.ghost{border:1px solid var(--accent);color:var(--accent);background:#fff}\n.strip{display:flex;gap:24px;flex-wrap:wrap;padding:14px 18px;background:#fff;border:1px solid var(--line);border-radius:10px;margin:8px 0 36px;font-size:.95em}.strip b{font-size:1.2em;display:block}.strip span{color:var(--muted);font-size:.85em}\nh2{font-size:1.35em;margin:36px 0 14px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}\n.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px}.card h3{margin:0 0 8px;font-size:1.05em}.card p{margin:0;color:var(--muted);font-size:.95em;line-height:1.45}.num{display:inline-block;width:26px;height:26px;border-radius:50%;background:var(--accent);color:#fff;text-align:center;line-height:26px;font-size:.85em;margin-right:8px}\n.tools{background:#fff;border:1px solid var(--line);border-radius:10px;padding:6px 18px}.tools div{display:grid;grid-template-columns:190px 1fr;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:.93em}.tools div:last-child{border-bottom:none}.tools code{font-family:ui-monospace,monospace;color:var(--accent)}\npre{background:#1f2430;color:#e6e8ec;padding:14px;border-radius:8px;overflow:auto;font-size:.82em}\n.rules{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:10px}.rule{padding:12px 14px;border-left:3px solid var(--accent);background:#fff;border-radius:6px;font-size:.93em}.rule b{display:block;margin-bottom:3px}\nfooter{margin:48px 0 30px;color:var(--muted);font-size:.85em;border-top:1px solid var(--line);padding-top:16px}\n</style></head><body>${nav(\"home\")}\n<div class=\"wrap\">\n  <section class=\"hero\">\n    <h1>Make your shop transactable by any AI buyer.</h1>\n    <p>Naka is the merchant's counter for the agentic web. Buyers' AI assistants browse your catalog and propose carts; your policy decides, a human confirms every payment on Razorpay, and every money action lands in a tamper-evident ledger. No model on your side \\u2014 nothing to talk into a discount.</p>\n    <a class=\"btn primary\" href=\"/onboard\">Onboard your shop</a>\n    <a class=\"btn ghost\" href=\"/console\">Sign in to your console</a>\n  </section>\n\n  <div class=\"strip\">\n    <div><b>${s.merchants}</b><span>shop${s.merchants===1?\"\":\"s\"} on this Naka</span></div>\n    <div><b>${s.paid}</b><span>paid orders</span></div>\n    <div><b>${s.ledger}</b><span>ledger entries, hash-chained</span></div>\n    <div><b>${s.mode===\"real\"?\"Razorpay test mode\":\"Simulated payments\"}</b><span>${s.mode===\"real\"?\"real test-mode orders and webhooks\":\"recorded client, no keys needed\"}</span></div>\n  </div>\n\n  <h2>How it works</h2>\n  <div class=\"cards\">\n    <div class=\"card\"><h3><span class=\"num\">1</span>Onboard in one form</h3><p>A shop name, a console password and a catalog JSON. Optional Razorpay test keys and two policy numbers. You get a console, a webhook URL and secret for the Razorpay dashboard, and a buyer agent kit.</p></div>\n    <div class=\"card\"><h3><span class=\"num\">2</span>Connect a buyer</h3><p>Paste the kit into Claude Code's <code>.mcp.json</code>, or run the Telegram bot. The agent signs every call with its own Ed25519 key and buys under a mandate you set \\u2014 categories, per-checkout cap, expiry.</p></div>\n    <div class=\"card\"><h3><span class=\"num\">3</span>Sell, safely</h3><p>Every cart passes your policy gate with named rules. Orders over your threshold wait for your approval. A human clicks Confirm on the pay page before any money moves. The ledger records all of it.</p></div>\n  </div>\n\n  <h2>What a buyer agent can do here</h2>\n  <div class=\"tools\">${tools.map(([n,d])=>`<div><code>${n}</code><span>${d}</span></div>`).join(\"\")}</div>\n\n  <h2>Connect from Claude Code</h2>\n  <p style=\"color:var(--muted);max-width:720px\">Mint a buyer agent in your console (or take the one from your onboarding kit), save its key, and add this to <code>.mcp.json</code>. The merchant's rules travel to the client as MCP server instructions. The demo shop on this server is <b>${s.defaultShop}</b>.</p>\n  <pre>{\n  \"mcpServers\": {\n    \"naka\": {\n      \"command\": \"node\",\n      \"args\": [\"node_modules/tsx/dist/cli.mjs\", \"apps/buyer/src/mcp-server.ts\"],\n      \"env\": {\n        \"NAKA_URL\": \"${base}\",\n        \"NAKA_MERCHANT\": \"&lt;merchant id&gt;\",\n        \"NAKA_AGENT_ID\": \"&lt;from your kit&gt;\",\n        \"NAKA_MANDATE_ID\": \"&lt;from your kit&gt;\",\n        \"NAKA_AGENT_KEY\": \"/path/to/agent.private.pem\"\n      }\n    }\n  }\n}</pre>\n\n  <h2>What is enforced, not promised</h2>\n  <div class=\"rules\">\n    <div class=\"rule\"><b>Explainable</b>Every decision carries rule ids and the numbers compared \\u2014 B1_MAX_PER_CHECKOUT: 349900 vs 300000.</div>\n    <div class=\"rule\"><b>Bounded</b>Merchant policy caps, per-agent daily caps, mandate scope and expiry, coupon table only \\u2014 the agent cannot set a price.</div>\n    <div class=\"rule\"><b>Gated</b>Orders are created only after a nonce-confirmed human click; large orders wait for you; refunds need your approval.</div>\n    <div class=\"rule\"><b>Audited</b>Append-only, SHA-256-chained ledger keyed to real Razorpay ids; verify and export from the console.</div>\n    <div class=\"rule\"><b>Recovers</b>Failed payments retry in-session; a webhook outage is covered by reconciliation against Razorpay.</div>\n    <div class=\"rule\"><b>No LLM on the merchant side</b>The buyer's assistant is the only model in the loop, and it holds no Razorpay credentials.</div>\n  </div>\n\n  <footer>Runs on Razorpay <b>test mode</b> only; the server refuses live keys. Manifest at <a href=\"/.well-known/naka.json\">/.well-known/naka.json</a>. Built for the Razorpay AI Buildathon.</footer>\n</div>\n</body></html>`}__name(landingPage,\"landingPage\");export{registerLandingRoutes};\n","warning