# Copy to .env and fill in when you have real keys. The system runs fully
# without any of these (RAZORPAY_MODE=recorded, no ANTHROPIC_API_KEY) using
# the recorded Razorpay client and the LLM-free replay buyer.

# --- Razorpay --------------------------------------------------------------
# RAZORPAY_MODE: "recorded" (default, no keys needed, uses packages/razorpay/src/fixtures)
#                "real" (requires test-mode keys below; refuses live keys)
RAZORPAY_MODE=recorded
RZP_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RZP_WEBHOOK_SECRET=
RZP_WEBHOOK_SECRET_PREVIOUS=

# --- Anthropic (buyer/live.ts only; replay buyer needs none of this) -------
ANTHROPIC_API_KEY=
NAKA_MODEL=claude-opus-5

# --- Server -----------------------------------------------------------------
NAKA_DB=./data/naka.db
NAKA_BASE_URL=http://localhost:3000
NAKA_PORT=3000
CONSOLE_PASSWORD=change-me
LEDGER_SALT=change-me-too
FAULT_INJECT=
